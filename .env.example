# ScriptGen - local secrets (2026-09-12 git-integration round)
#
# Copy this file to ".env" (already gitignored - never commit the real
# one) and fill in real values, OR set these as real OS/PowerShell
# environment variables instead - either works, see app/config.py and
# app/utils/dotenv_lite.py. Both are optional: leave them unset and the
# app starts with a blank connection/AI key, which you can then fill in
# through Settings after first run.

# The SQL Server password for the default tunnel connection
# (ConnectionConfig "Default (Local Tunnel)" - username ouc_read_only,
# localhost:1433). Only seeds the FIRST-EVER data/config.json; changing
# this later does nothing until you delete data/config.json or edit the
# connection in Settings yourself.
SCRIPTGEN_DB_PASSWORD=

# Gemini API key for AI Assist / Explain / Optimize. Same "only seeds a
# blank config" behavior as above.
SCRIPTGEN_AI_API_KEY=
