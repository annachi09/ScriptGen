.venv/
__pycache__/
*.pyc
data/
build/
dist/
*.spec
.pytest_cache/
exports/

# Local secrets (2026-09-12 git-integration round) - see .env.example.
# Never commit the real .env; *.key covers scriptgen.key/web_session.key
# if either ever ends up somewhere other than data/ (which is already
# ignored above - this is belt-and-suspenders, not the primary guard).
.env
*.key

# Dev harness (2026-11-22): per-run worktrees, run artifacts and the active-run marker
# stay local. The agents/skill/hook/settings in .claude/ ARE meant to be committed.
.claude/worktrees/
.claude/harness/runs/
.claude/harness/ACTIVE
.claude/settings.json.bak
.claude/settings.local.json

# Editor/OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db

# Coverage / misc test artifacts
.coverage
htmlcov/
